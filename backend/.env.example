NODE_ENV=development
PORT=4000
HOST=0.0.0.0
TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://verysure:replace_me@127.0.0.1:55432/verysure?schema=public
# Optional direct connection for migrations when DATABASE_URL uses a pooler.
DIRECT_URL=
TEST_DATABASE_URL=postgresql://verysure:replace_me@127.0.0.1:55432/verysure_test?schema=public
CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:19006
PUBLIC_API_URL=http://localhost:4000
SESSION_SECRET=replace_with_at_least_32_random_characters
OTP_SECRET=replace_with_at_least_32_random_characters
PHOTO_SIGNING_SECRET=replace_with_at_least_32_random_characters
OTP_PROVIDER=demo
PAYMENT_PROVIDER=demo
ALLOW_DEMO_PAYMENTS=true
UPLOAD_DIR=./uploads
SEED_PASSWORD=replace_with_a_development_password
# Set real provider credentials locally when enabling the provider.
RESEND_API_KEY=
OTP_FROM=Verysure <no-reply@example.com>
# Set OTP_PROVIDER=smtp for SMTP email delivery (Gmail requires an app password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Verysure <no-reply@example.com>"
PAYMENT_INITIATE_URL=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
# Paystack hosted checkout uses only the server secret key, never the APK.
# Set PAYMENT_PROVIDER=paystack and ALLOW_DEMO_PAYMENTS=false.
PAYSTACK_SECRET_KEY=
# Database photo storage survives Render Free restarts; local is optional.
PHOTO_STORAGE=database
